<Application x:Class="Pad.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pad">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme/Palette.xaml" />
        <ResourceDictionary Source="Theme/LineIcons.xaml" />
        <ResourceDictionary Source="Theme/Controls.xaml" />
        <ResourceDictionary Source="Theme/Inputs.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Kill the system dotted focus rectangle for every control. -->
      <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate />
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
