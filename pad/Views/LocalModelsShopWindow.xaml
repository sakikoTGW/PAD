<Window x:Class="Pad.Views.LocalModelsShopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本地模型"
        Icon="pack://application:,,,/Assets/pad-logo.png"
        Width="760" Height="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource FontUI}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border Margin="16" CornerRadius="14" Background="{StaticResource BgCard}"
          BorderBrush="{StaticResource LineBorder}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.24" Color="#101820" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Background="{StaticResource BgChrome}" CornerRadius="14,14,0,0"
              MouseLeftButtonDown="Bar_Drag">
        <Grid Margin="12,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Width="22" Height="22" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Source="pack://application:,,,/Assets/pad-logo.png" />
            <TextBlock Text="本地模型" Foreground="#E9EFF2" FontSize="13" FontWeight="SemiBold"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Ellipse x:Name="Dot" Width="6" Height="6" Fill="#4FBF9A" VerticalAlignment="Center" />
            <TextBlock x:Name="BarStatus" Text="正在检测…" Foreground="#9FB0BA"
                       FontSize="11.5" Margin="7,0,10,0" VerticalAlignment="Center" />
            <Button Content="✕" Width="28" Height="28" Cursor="Hand"
                    Background="Transparent" BorderThickness="0" Foreground="#B9C6CD"
                    FontSize="11" Click="Close_Click" ToolTip="关闭" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="264" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border BorderBrush="{StaticResource LineBorder}" BorderThickness="0,0,1,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" x:Name="ListCap" Text="模型"
                       FontSize="{StaticResource FsMicro}" Foreground="{StaticResource TextMuted}"
                       Margin="16,12,0,4" />
            <ListBox x:Name="ModelList" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ModelList_SelectionChanged">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Box" Background="Transparent" CornerRadius="8" Margin="8,1">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource BgSubtle}" />
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentWash}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="10,7">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}" FontSize="11"
                               Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <StackPanel Grid.Column="1" Margin="22,18,22,16">
          <TextBlock x:Name="ModelTitle" Text="—" FontSize="22" FontWeight="Bold"
                     Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="Sub" Text="来自 ollama.com/library" FontSize="11.5"
                     Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
          <TextBlock x:Name="Desc" FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                     Foreground="{StaticResource TextBody}" Margin="0,12,0,0" MaxWidth="420" />
          <TextBlock x:Name="Meta" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0" />

          <Border Height="1" Background="{StaticResource LineBorder}" Margin="0,14,0,12" />
          <TextBlock Text="版本" FontSize="{StaticResource FsMicro}"
                     Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" />
          <WrapPanel x:Name="TagRow" />

          <Grid Margin="0,10,0,0" VerticalAlignment="Bottom">
            <TextBlock x:Name="PullText" VerticalAlignment="Center" FontSize="{StaticResource FsMicro}"
                       Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"
                       MaxWidth="260" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="CancelBtn" Style="{StaticResource BtnSm}" Content="取消"
                      Margin="0,0,8,0" Visibility="Collapsed" Click="Cancel_Click" />
              <Button x:Name="PullBtn" Style="{StaticResource BtnPrimary}" Content="拉取"
                      Height="34" MinWidth="96" Click="Pull_Click" />
            </StackPanel>
          </Grid>
          <ProgressBar x:Name="Bar" Height="4" Margin="0,10,0,0" Minimum="0" Maximum="100"
                       Visibility="Collapsed" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
