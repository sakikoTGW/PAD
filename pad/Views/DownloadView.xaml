<UserControl x:Class="Pad.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pad.Views"
             xmlns:v="clr-namespace:Pad.Views"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
  <UserControl.Resources>
    <local:BoolToVis x:Key="B2V" />
    <local:BoolToVis x:Key="B2VNot" Invert="True" />
    <DataTemplate x:Key="DlJobRow">
      <Grid Height="72" Margin="0,0,0,2" Background="Transparent"
            MouseLeftButtonUp="Row_Click" Tag="{Binding Job}" Cursor="Hand">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentWash}" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- 图标只显示任务自己的图（整合包/实例图标，InstMark 统一解析），
             状态不再画图标：运行用呼吸灯，暂停/完成/失败看文字和按钮。 -->
        <Grid Grid.Column="0" Width="50" Height="50" VerticalAlignment="Center" Margin="0,0,14,0">
          <v:InstMark IconPath="{Binding IconPath}" />
          <local:RunLamp Running="{Binding ShowRunningLamp}" Width="10" Height="10"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" />
          <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Success}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                  Visibility="{Binding IsDone, Converter={StaticResource B2V}}">
            <v:Ico Glyph="{StaticResource I.Check}" Height="9" Foreground="White" />
          </Border>
          <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Danger}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                  Visibility="{Binding IsFailed, Converter={StaticResource B2V}}">
            <v:Ico Glyph="{StaticResource I.Close}" Height="8" Foreground="White" />
          </Border>
          <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource TextMuted}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                  Visibility="{Binding IsCancelled, Converter={StaticResource B2V}}">
            <v:Ico Glyph="{StaticResource I.Close}" Height="8" Foreground="White" />
          </Border>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock FontSize="{StaticResource FsTitle}" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimary}"
                     TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                     TextTrimming="CharacterEllipsis" Text="{Binding Line}" />
          <ProgressBar Style="{StaticResource Meter}" Height="4" Margin="0,8,0,0"
                       Minimum="0" Maximum="100"
                       Value="{Binding Percent, Mode=OneWay}"
                       Visibility="{Binding ShowMeter, Converter={StaticResource B2V}}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource BtnSm}" Content="暂停" Height="26"
                  Padding="9,0" FontSize="{StaticResource FsSmall}"
                  Click="Pause_Click" Tag="{Binding Job}"
                  Visibility="{Binding CanPause, Converter={StaticResource B2V}}"
                  v:Ico.Of="{StaticResource I.Pause}" />
          <Button Style="{StaticResource BtnSm}" Content="继续" Height="26"
                  Padding="9,0" FontSize="{StaticResource FsSmall}"
                  Click="Pause_Click" Tag="{Binding Job}"
                  Visibility="{Binding CanResume, Converter={StaticResource B2V}}"
                  v:Ico.Of="{StaticResource I.Play}" />
          <Button Style="{StaticResource BtnDanger}" Content="取消" Height="26" Margin="6,0,0,0"
                  Padding="11,0" FontSize="{StaticResource FsSmall}"
                  Click="Cancel_Click" Tag="{Binding Job}"
                  Visibility="{Binding CanCancel, Converter={StaticResource B2V}}"
                  v:Ico.Of="{StaticResource I.Stop}" />
          <Button Style="{StaticResource BtnSm}" Content="删除" Height="26" Margin="6,0,0,0"
                  Padding="9,0" FontSize="{StaticResource FsSmall}"
                  ToolTip="取消并从列表删除"
                  Click="Delete_Click" Tag="{Binding Job}"
                  Visibility="{Binding CanCancel, Converter={StaticResource B2V}}"
                  v:Ico.Of="{StaticResource I.Close}" />
          <Button Style="{StaticResource BtnSm}" Content="在文件夹中显示"
                  Click="Folder_Click" Tag="{Binding Job}"
                  Visibility="{Binding CanForget, Converter={StaticResource B2V}}"
                  v:Ico.Of="{StaticResource I.Folder}" />
          <Button Style="{StaticResource IcoBtn}" Margin="6,0,0,0"
                  Click="Forget_Click" Tag="{Binding Job}"
                  Visibility="{Binding CanForget, Converter={StaticResource B2V}}"
                  ToolTip="从列表中删除">
            <v:Ico Glyph="{StaticResource I.Close}" Height="10" />
          </Button>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Left rail is destinations only. Shelf categories live as chips inside 插件商店. -->
    <Border x:Name="StoreRail" Grid.Column="0" Width="168" Background="{StaticResource BgSidebar}"
            BorderThickness="0,0,1,0" BorderBrush="{StaticResource LineBorder}">
      <Grid Margin="8,12,8,0" local:Fx.SlideSelect="nav">
        <Border Style="{StaticResource SlideThumbNav}">
          <Border.RenderTransform>
            <TranslateTransform />
          </Border.RenderTransform>
          <Border Width="3" HorizontalAlignment="Left" Margin="0,9" CornerRadius="2"
                  Background="{StaticResource Accent}" />
        </Border>
        <StackPanel>
          <RadioButton x:Name="NavRelease" Style="{StaticResource NavItem}" Content="发行号"
                       v:Ico.Of="{StaticResource I.Block}" IsChecked="True" Checked="Nav_Checked"
                       GroupName="dlNav" Tag="release" />
          <RadioButton x:Name="NavMarket" Style="{StaticResource NavItem}" Content="插件商店"
                       v:Ico.Of="{StaticResource I.Mod}" Checked="Nav_Checked"
                       GroupName="dlNav" Tag="market" />
          <RadioButton x:Name="NavDlTasks" Style="{StaticResource NavItem}" Content="下载任务"
                       v:Ico.Of="{StaticResource I.Tasks}" Checked="Nav_Checked"
                       GroupName="dlNav" Tag="dltasks" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <!-- 发行号 -->
      <ScrollViewer x:Name="PaneRelease" Padding="{StaticResource PadPage}" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Slab}">
            <StackPanel>
              <ContentControl Style="{StaticResource SlabHead}" Content="下载 DSH"
                              v:Ico.Of="{StaticResource I.Download}" />
              <Grid Height="28">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="版本" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="0,0,18,0" />
                <ComboBox Grid.Column="1" x:Name="VersionBox" Width="200" Height="28"
                          IsEditable="True"
                          FontFamily="{StaticResource FontMono}" />
              </Grid>
              <Grid Height="35" Margin="0,8,0,0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="FetchBtn" Style="{StaticResource BtnWide}" Content="刷新"
                          Margin="0,0,20,0" Click="Fetch_Click"
                          v:Ico.Of="{StaticResource I.Globe}"
                          ToolTip="获取版本列表" />
                  <Button x:Name="InstallBtn" Style="{StaticResource BtnWidePrimary}" Content="安装"
                          Click="Install_Click" v:Ico.Of="{StaticResource I.Download}" />
                  <ContentControl x:Name="Busy" Style="{StaticResource Spinner}" Margin="20,0,0,0"
                                  VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
              </Grid>
              <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,14,6">
                  <Border x:Name="NodePip" Style="{StaticResource Pip}"
                          Background="{StaticResource InkDisabled}" />
                  <TextBlock Text="node" Style="{StaticResource Label}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="NodeLine" Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource Mono}" Margin="{StaticResource GapTight}" />
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,14,0">
                  <Border x:Name="PnpmPip" Style="{StaticResource Pip}"
                          Background="{StaticResource InkDisabled}" />
                  <TextBlock Text="pnpm" Style="{StaticResource Label}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="PnpmLine" Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource Mono}" />
              </Grid>
              <TextBlock x:Name="ToolHint" Style="{StaticResource Muted}" Margin="0,10,0,0"
                         Visibility="Collapsed" />
            </StackPanel>
          </Border>

          <!-- Own modules: Collapsed takes no space; when shown, GapModule matches Slab-to-Slab. -->
          <ProgressBar x:Name="InstallMeter" Style="{StaticResource Meter}" Height="8"
                       Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"
                       Margin="{StaticResource GapModule}" />
          <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" Height="0" Visibility="Collapsed"
                   Margin="{StaticResource GapModule}" />

          <Border Style="{StaticResource Slab}"
                  Visibility="{Binding HasRemoteReleases, Converter={StaticResource B2V}}">
            <StackPanel>
              <Grid Margin="{StaticResource GapField}">
                <ContentControl Style="{StaticResource SlabHead}" Content="npm 发行号" Margin="0"
                                 v:Ico.Of="{StaticResource I.Globe}" VerticalAlignment="Center" />
                <ContentControl Style="{StaticResource Quant}" HorizontalAlignment="Right"
                                Margin="0" v:Ico.Of="{StaticResource I.Block}"
                                Content="{Binding RemoteReleases.Count}"
                                ContentStringFormat="{}{0} 个" />
              </Grid>
              <ItemsControl x:Name="RemoteList" ItemsSource="{Binding RemoteReleases}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid local:Fx.Enter="row" Height="52">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Version}" FontFamily="{StaticResource FontMono}"
                                   FontSize="{StaticResource FsRow}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                          <ContentControl Style="{StaticResource QuantLoud}" Content="latest"
                                          Visibility="{Binding Latest, Converter={StaticResource B2V}}" />
                          <ContentControl Style="{StaticResource Quant}"
                                          v:Ico.Of="{StaticResource I.Upload}"
                                          Content="{Binding TimeText}"
                                          Visibility="{Binding HasTime, Converter={StaticResource B2V}}" />
                          <ContentControl Style="{StaticResource Quant}" Margin="0"
                                          v:Ico.Of="{StaticResource I.Check}" Content="已装"
                                          Visibility="{Binding Installed, Converter={StaticResource B2V}}" />
                        </StackPanel>
                      </StackPanel>
                      <Button Grid.Column="1" Style="{StaticResource BtnWidePrimary}" Content="安装"
                              Click="InstallRemote_Click" Tag="{Binding}"
                              Visibility="{Binding CanInstall, Converter={StaticResource B2V}}"
                              v:Ico.Of="{StaticResource I.Download}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Slab}"
                  Visibility="{Binding HasReleases, Converter={StaticResource B2V}}">
            <StackPanel>
              <Grid Margin="{StaticResource GapField}">
                <ContentControl Style="{StaticResource SlabHead}" Content="版本库" Margin="0"
                                 v:Ico.Of="{StaticResource I.Pack}" VerticalAlignment="Center" />
                <ContentControl Style="{StaticResource Quant}" HorizontalAlignment="Right"
                                Margin="0" v:Ico.Of="{StaticResource I.Block}"
                                Content="{Binding Releases.Count}"
                                ContentStringFormat="{}{0} 个发行号" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Releases}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid local:Fx.Enter="row" Height="52">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Version}" FontFamily="{StaticResource FontMono}"
                                   FontSize="{StaticResource FsRow}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                          <ContentControl Style="{StaticResource Quant}"
                                          v:Ico.Of="{StaticResource I.Gear}"
                                          Content="{Binding VerifyOutput}" />
                          <ContentControl Style="{StaticResource Quant}" Margin="0"
                                          v:Ico.Of="{StaticResource I.Tasks}" Content="已校验"
                                          Visibility="{Binding Verified, Converter={StaticResource B2V}}" />
                          <ContentControl Style="{StaticResource PillWarn}" Content="没通过校验"
                                          Visibility="{Binding Verified, Converter={StaticResource B2VNot}}" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnSm}" Content="校验" Click="Verify_Click"
                                Tag="{Binding}" ToolTip="跑 --version 再记一次校验结果"
                                v:Ico.Of="{StaticResource I.Check}" />
                        <Button Style="{StaticResource BtnSm}" Content="打开目录" Margin="6,0,0,0"
                                Click="OpenVersion_Click" Tag="{Binding}"
                                ToolTip="打开这份发行号的版本目录"
                                v:Ico.Of="{StaticResource I.Folder}" />
                        <Button Style="{StaticResource BtnDanger}" Height="26" Padding="11,0"
                                FontSize="{StaticResource FsSmall}" Content="删除" Margin="8,0,0,0"
                                Click="Remove_Click" Tag="{Binding}"
                                ToolTip="从版本库里删掉这份发行号"
                                v:Ico.Of="{StaticResource I.Trash}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Slab}" Padding="{StaticResource PadSlab}" MaxWidth="380"
                  HorizontalAlignment="Center" Margin="0,40,0,0"
                  Visibility="{Binding ShowReleaseEmpty, Converter={StaticResource B2V}}">
            <StackPanel>
              <ContentControl Style="{StaticResource PictLg}" v:Ico.Of="{StaticResource I.Download}"
                              HorizontalAlignment="Left" Margin="{StaticResource GapField}" />
              <TextBlock Text="未找到可用的 DSH" Style="{StaticResource SectionTitle}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- 社区资源：列表铺满；页码栏浮在内容上方（与推荐页同层，不另占底行）。 -->
      <Grid x:Name="PaneMarket" Visibility="Collapsed">
        <Grid x:Name="PaneMarketList">
        <ScrollViewer x:Name="MarketScroll" Padding="{StaticResource PadPage}"
                      Style="{StaticResource OverlayScroll}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,72">
          <StackPanel>
            <StackPanel Visibility="Collapsed">
              <TextBlock x:Name="ShelfTitle" />
              <Border>
                <Border.RenderTransform>
                  <RotateTransform x:Name="StoreMoreAngle" />
                </Border.RenderTransform>
              </Border>
            </StackPanel>
            <Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock x:Name="StoreHeading" Text="插件商店" FontSize="33" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock x:Name="StoreSubtitle" Text="社区插件 · 一键安装"
                           Style="{StaticResource Muted}" FontSize="{StaticResource FsSmall}"
                           Margin="14,0,0,7" VerticalAlignment="Center" />
              </StackPanel>
              <Button x:Name="StoreMoreBtn" Style="{StaticResource Btn}" Content="筛选"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Click="StoreMore_Click" Padding="14,0" />
            </Grid>

            <!-- 装到哪：常驻一行，不再藏在「筛选」里；右边顺手写出落地目录。 -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Text="装到" Style="{StaticResource Muted}" VerticalAlignment="Center" />
              <ComboBox x:Name="TargetInstance" Width="200" Height="28" Margin="10,0,0,0"
                        ItemsSource="{Binding Instances}"
                        SelectionChanged="TargetInstance_Changed">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="·" Style="{StaticResource Muted}" Margin="7,0"
                         VerticalAlignment="Center" />
              <ComboBox x:Name="TargetProfile" Width="150" Height="28"
                        ToolTip="装进这个 profile 的 node_modules，并写进它的 package.json"
                        SelectionChanged="TargetProfile_Changed">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock x:Name="TargetHint" Style="{StaticResource Muted}"
                         FontSize="{StaticResource FsSmall}" Margin="12,0,0,0"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         MaxWidth="380" />
            </StackPanel>

            <Border Margin="0,16,0,0" Height="35" CornerRadius="{StaticResource RadCard}"
                    Background="{StaticResource BgCard}" BorderThickness="1"
                    BorderBrush="{StaticResource LineBorder}" ClipToBounds="True">
              <Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Column="0">
                    <ContentControl Style="{StaticResource Pict}" v:Ico.Of="{StaticResource I.Search}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="14,0,0,0" />
                    <TextBox x:Name="SearchBox" Style="{StaticResource FieldEmbed}"
                             Margin="42,0,10,0" VerticalContentAlignment="Center"
                             Tag="搜索插件、作者、关键词…" KeyDown="Search_Key" />
                  </Grid>
                  <Button Grid.Column="1" x:Name="SearchBtn" Content="搜索" Padding="22,0"
                          Click="Search_Click" FontWeight="SemiBold"
                          Foreground="{StaticResource TextOnAccent}" Cursor="Hand">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Grid x:Name="root">
                          <Border Background="{StaticResource AccentDeep}" CornerRadius="0,8,8,0" />
                          <Border x:Name="hot" Background="{StaticResource AccentPress}"
                                  CornerRadius="0,8,8,0" Opacity="0" />
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                              <BeginStoryboard>
                                <Storyboard>
                                  <DoubleAnimation Storyboard.TargetName="hot" Storyboard.TargetProperty="Opacity"
                                                   To="1" Duration="0:0:0.16" />
                                </Storyboard>
                              </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                              <BeginStoryboard>
                                <Storyboard>
                                  <DoubleAnimation Storyboard.TargetName="hot" Storyboard.TargetProperty="Opacity"
                                                   To="0" Duration="0:0:0.16" />
                                </Storyboard>
                              </BeginStoryboard>
                            </Trigger.ExitActions>
                          </Trigger>
                          <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Trigger.EnterActions>
                              <BeginStoryboard>
                                <Storyboard>
                                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity"
                                                   To="0.38" Duration="0:0:0.2" />
                                </Storyboard>
                              </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                              <BeginStoryboard>
                                <Storyboard>
                                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity"
                                                   To="1" Duration="0:0:0.2" />
                                </Storyboard>
                              </BeginStoryboard>
                            </Trigger.ExitActions>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </Grid>
              </Grid>
            </Border>

            <!-- Categories are filters inside the store, not left-rail destinations. -->
            <ScrollViewer x:Name="ShelfChipScroll" Margin="0,14,0,0"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Focusable="False">
              <Grid x:Name="ShelfChipHost">
                <Border x:Name="ShelfPill" Style="{StaticResource SlideThumbPill}" Opacity="0"
                        RenderTransformOrigin="0,0.5">
                  <Border.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform x:Name="ShelfPillScale" />
                      <TranslateTransform x:Name="ShelfPillShift" />
                    </TransformGroup>
                  </Border.RenderTransform>
                </Border>
                <StackPanel x:Name="ShelfChipRow" Orientation="Horizontal" />
              </Grid>
            </ScrollViewer>

            <Border x:Name="ChipRowHost" ClipToBounds="True" Visibility="Collapsed">
            <StackPanel x:Name="ChipRow" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Top">
              <StackPanel.RenderTransform>
                <TranslateTransform x:Name="ChipRowShift" />
              </StackPanel.RenderTransform>
              <RadioButton x:Name="ModeAll" Style="{StaticResource FilterTab}" Content="全部插件"
                           GroupName="storeMode" Visibility="Collapsed" Checked="StoreMode_Changed" />
              <RadioButton x:Name="ModeStars" Style="{StaticResource FilterTab}" Content="Star 增长"
                           GroupName="storeMode" Margin="8,0,0,0" Visibility="Collapsed" Checked="StoreMode_Changed" />
              <RadioButton x:Name="ModeDownloads" Style="{StaticResource FilterTab}" Content="下载增长"
                           GroupName="storeMode" Margin="8,0,0,0" IsChecked="True" Visibility="Collapsed"
                           Checked="StoreMode_Changed" />
              <Grid x:Name="PeriodHost" Margin="8,0,0,0">
                <Border x:Name="PeriodPill" Style="{StaticResource SlideThumbPill}" Opacity="0"
                        RenderTransformOrigin="0,0.5">
                  <Border.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform x:Name="PeriodPillScale" />
                      <TranslateTransform x:Name="PeriodPillShift" />
                    </TransformGroup>
                  </Border.RenderTransform>
                </Border>
                <StackPanel x:Name="PeriodRow" Orientation="Horizontal">
                  <RadioButton x:Name="PeriodDay" Style="{StaticResource FilterTab}" Content="日"
                               GroupName="storePeriod" Margin="0" Checked="StorePeriod_Changed" />
                  <RadioButton x:Name="PeriodWeek" Style="{StaticResource FilterTab}" Content="周"
                               GroupName="storePeriod" IsChecked="True" Margin="6,0,0,0"
                               Checked="StorePeriod_Changed" />
                  <RadioButton x:Name="PeriodMonth" Style="{StaticResource FilterTab}" Content="月"
                               GroupName="storePeriod" Margin="6,0,0,0" Checked="StorePeriod_Changed" />
                </StackPanel>
              </Grid>
              <TextBlock x:Name="StoreSortNote" Style="{StaticResource Muted}"
                         FontSize="{StaticResource FsSmall}" Margin="14,0,0,0"
                         VerticalAlignment="Center" />
            </StackPanel>
            </Border>

            <StackPanel x:Name="StoreMore" Visibility="Collapsed" Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,28,0">
                  <TextBlock Text="版本" Style="{StaticResource Label}" Margin="{StaticResource GapTight}" />
                  <ComboBox x:Name="TargetRelease" Width="160" Height="28" IsEditable="False"
                            ToolTip="这份实例钉的 DSH 发行号" />
                </StackPanel>

              </StackPanel>
              <Grid Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="ClearBtn" Style="{StaticResource BtnWide}" Content="重置条件"
                          Click="Clear_Click" ToolTip="重置条件" v:Ico.Of="{StaticResource I.Globe}" />
                  <ContentControl x:Name="MarketBusy" Style="{StaticResource Spinner}"
                                  Margin="16,0,0,0" VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                  <TextBlock x:Name="MarketStatus" Style="{StaticResource Muted}" Margin="10,0,0,0"
                             VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="排序" Style="{StaticResource Label}" VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox x:Name="SortBox" Width="120" Height="28" SelectionChanged="Sort_Changed">
                  <ComboBoxItem Tag="hot" Content="热度" IsSelected="True" />
                  <ComboBoxItem Tag="date" Content="最近更新" />
                  <ComboBoxItem Tag="name" Content="名称" />
                  <ComboBoxItem Tag="stars" Content="Star 数" />
                  <ComboBoxItem Tag="downloads" Content="下载量" />
                </ComboBox>
                <TextBlock Text="分类" Style="{StaticResource Label}" VerticalAlignment="Center"
                           Margin="18,0,8,0" />
                <ComboBox x:Name="TagBox" Width="140" Height="28" SelectionChanged="Tag_Changed" />
                <CheckBox x:Name="InstalledOnly" Content="只看已安装" Margin="18,0,0,0"
                          VerticalAlignment="Center" Checked="StoreFilter_Changed"
                          Unchecked="StoreFilter_Changed" />

                <CheckBox x:Name="CompatibleOnly" Content="只看兼容" Margin="18,0,0,0"
                          VerticalAlignment="Center" Checked="StoreFilter_Changed"
                          Unchecked="StoreFilter_Changed"
                          ToolTip="按插件 package.json 的 engines.dsh 判断" />
                <TextBlock Text="合集" Style="{StaticResource Label}" VerticalAlignment="Center"
                           Margin="18,0,8,0" />
                <ComboBox x:Name="CollectionBox" Width="104" Height="28" SelectionChanged="Sort_Changed">
                  <ComboBoxItem Tag="all" Content="全部" IsSelected="True" />
                  <ComboBoxItem Tag="featured" Content="精选" />
                  <ComboBoxItem Tag="official" Content="官方" />
                  <ComboBoxItem Tag="community" Content="社区" />
                </ComboBox>
              </StackPanel>
            </StackPanel>

            <!-- Hero：本周增长最快；首页默认就是这个视图 -->
            <Border x:Name="GrowthHero" Visibility="Collapsed" Height="172" Margin="0,18,0,0"
                    CornerRadius="{StaticResource RadCard}" ClipToBounds="True">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#1B2227" Offset="0" />
                  <GradientStop Color="#2A343B" Offset="0.55" />
                  <GradientStop Color="#171E23" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="HeroKicker" Text="本周增长最快" Foreground="#E8B26A" FontSize="11"
                             FontWeight="Bold" />
                  <TextBlock x:Name="HeroTitle" Foreground="White" FontSize="27" FontWeight="Bold"
                             Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                  <TextBlock x:Name="HeroDesc" Foreground="#C3CBD1" FontSize="12.5"
                             Margin="0,6,0,0" MaxWidth="560" HorizontalAlignment="Left"
                             TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Style="{StaticResource BtnPrimary}" Content="查看" Height="35"
                            Padding="20,0" Click="HeroOpen_Click" />
                    <Button Style="{StaticResource Btn}" Content="安装" Height="35"
                            Padding="18,0" Margin="10,0,0,0" Click="HeroInstall_Click" />
                  </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Width="86" Height="86" CornerRadius="{StaticResource RadCard}"
                        Background="#33FFFFFF" VerticalAlignment="Center" Margin="20,0,4,0">
                  <v:PluginMark x:Name="HeroIcon" Width="70" Height="70" Size="70" />
                </Border>
              </Grid>
            </Border>

            <Grid x:Name="StoreSectionHead" Margin="2,20,2,12">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StoreSectionTitle" Text="推荐" FontSize="17"
                           FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock x:Name="StoreSectionSub" Style="{StaticResource Muted}"
                           Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="{StaticResource FsSmall}" />
                <TextBlock x:Name="ResultCount" Visibility="Collapsed" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                <Button x:Name="StoreLayoutBtn" Style="{StaticResource IcoBtn}"
                        ToolTip="显示" Margin="0,0,6,0" Click="StoreLayout_Click">
                  <v:Ico Glyph="{StaticResource I.Gear}" Height="13" />
                </Button>
                <TextBlock x:Name="StoreSectionRight" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" FontSize="{StaticResource FsSmall}"
                           Margin="0,0,14,0" />
                <Button x:Name="StoreModeLink" Style="{StaticResource BtnGhost}"
                        Content="浏览全部插件 ›" Height="26" Padding="8,0"
                        FontSize="{StaticResource FsSmall}" Click="StoreModeLink_Click" />
              </StackPanel>
            </Grid>

          </StackPanel>

          <Border x:Name="MarketError" Style="{StaticResource BannerWarn}" Margin="{StaticResource GapModule}"
                  Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentControl Grid.Column="0" Style="{StaticResource Pict}"
                              v:Ico.Of="{StaticResource I.Info}" Margin="0,2,12,0" />
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="MarketErrorTitle" FontSize="{StaticResource FsBody}"
                           FontWeight="SemiBold" Foreground="{StaticResource WarningText}"
                           Text="搜索没连上" />
                <TextBlock x:Name="MarketErrorText" Style="{StaticResource Muted}"
                           Foreground="{StaticResource WarningText}" Margin="0,4,0,0"
                           FontSize="{StaticResource FsSmall}" TextWrapping="Wrap" />
                <TextBlock x:Name="MarketErrorHint" Style="{StaticResource Muted}"
                           Foreground="{StaticResource WarningText}" Margin="0,4,0,0"
                           FontSize="{StaticResource FsMicro}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="2" Style="{StaticResource BtnSm}" Content="重试"
                      Click="Search_Click" Margin="16,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <Grid>
          <Border x:Name="ResultCard" Padding="0" Background="Transparent" Visibility="Collapsed">
            <ItemsControl x:Name="ResultList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- Outer grid owns the staggered enter; inner border owns hover lift. -->
                  <Grid Margin="7">
                  <Border MinHeight="188" CornerRadius="{StaticResource RadCard}" local:Fx.Hover="lift"
                          Cursor="Hand" Background="{StaticResource BgCard}"
                          BorderBrush="{StaticResource LineBorder}" BorderThickness="1"
                          Tag="{Binding}" MouseLeftButtonUp="Row_OpenDetail">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.07"
                                        Color="#101820" />
                    </Border.Effect>
                    <Grid Margin="16,15,16,13">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <v:PluginMark Grid.Column="0" Width="52" Height="52" Size="52"
                                      IconPath="{Binding IconPath}" Pending="{Binding IconPending}"
                                      Spec="{Binding Name}" VerticalAlignment="Top" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                          <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="Bold"
                                     Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"
                                     MaxHeight="40" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Publisher}" FontSize="10.5"
                                     Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="2" MinWidth="24" Height="24" CornerRadius="12"
                                Background="{StaticResource AccentWash}" VerticalAlignment="Top"
                                Visibility="{Binding HasRank, Converter={StaticResource B2V}}">
                          <TextBlock Text="{Binding Rank}" FontSize="11" FontWeight="Bold"
                                     Foreground="{StaticResource Accent}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding DescriptionText}" FontSize="12"
                                 Foreground="{StaticResource TextSecondary}" Margin="0,11,0,0"
                                 TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding DescriptionText}" />
                      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0"
                                  Visibility="{Binding HasStats, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding StarsText}" FontSize="10.5" Margin="0,0,12,0"
                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DownloadsText}" FontSize="10.5" Margin="0,0,12,0"
                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                        <Border CornerRadius="6" Padding="5,1" Background="{StaticResource SuccessWash}"
                                Visibility="{Binding IsCompatible, Converter={StaticResource B2V}}">
                          <TextBlock Text="兼容" FontSize="10" Foreground="{StaticResource SuccessText}" />
                        </Border>
                        <Border CornerRadius="6" Padding="5,1" Background="{StaticResource DangerWash}"
                                Visibility="{Binding IsIncompatible, Converter={StaticResource B2V}}">
                          <TextBlock Text="不兼容" FontSize="10" Foreground="{StaticResource DangerText}" />
                        </Border>
                      </StackPanel>
                      <Grid Grid.Row="3" Margin="0,11,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Border BorderBrush="{StaticResource LineBorder}" BorderThickness="1"
                                  CornerRadius="6" Padding="6,1" Margin="0,0,8,0">
                            <TextBlock Text="{Binding VersionText}" FontSize="10.5"
                                       Foreground="{StaticResource TextMuted}" />
                          </Border>
                          <TextBlock Text="{Binding DateText}" FontSize="10.5"
                                     Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                        <TextBlock Text="{Binding GrowthBadge}" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Visibility="{Binding HasGrowth, Converter={StaticResource B2V}}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource Success}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding GrowthSign}" Value="neg">
                                  <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding GrowthSign}" Value="zero">
                                  <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                    </Grid>
                  </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          </Grid>

          <Border x:Name="StoreBusy" Visibility="Collapsed" MinHeight="180"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,28,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <ContentControl Style="{StaticResource Spinner}" VerticalAlignment="Center" />
              <TextBlock x:Name="StoreBusyText" Text="正在加载" Style="{StaticResource Muted}"
                         Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Border x:Name="LoadCard" Style="{StaticResource Slab}" Padding="40,30"
                  HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <ContentControl Style="{StaticResource Spinner}" VerticalAlignment="Center" />
              <TextBlock Text="正在获取版本列表" Style="{StaticResource Muted}"
                         Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Border x:Name="EmptyCard" Style="{StaticResource Slab}" Padding="{StaticResource PadSlab}"
                  MaxWidth="380" HorizontalAlignment="Center" Margin="0,40,0,0"
                  Visibility="Collapsed">
            <StackPanel>
              <ContentControl Style="{StaticResource PictLg}" v:Ico.Of="{StaticResource I.Search}"
                              HorizontalAlignment="Left" Margin="{StaticResource GapField}" />
              <TextBlock Text="无搜索结果" Style="{StaticResource SectionTitle}" Margin="{StaticResource GapTight}" />
              <Border Height="2" Background="{StaticResource Accent}" HorizontalAlignment="Left"
                      Width="34" />
              <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" Margin="0,15,0,0"
                         TextWrapping="Wrap" />
              <Button x:Name="EmptyCrossBtn" Style="{StaticResource BtnWide}" Content="在全部插件中搜索"
                      Margin="0,16,0,0" HorizontalAlignment="Left" Visibility="Collapsed"
                      Click="EmptyCross_Click" v:Ico.Of="{StaticResource I.Search}" />
            </StackPanel>
          </Border>


        </StackPanel>
        </ScrollViewer>
        <Border x:Name="StoreEdgeFade" VerticalAlignment="Bottom" Height="120"
                IsHitTestVisible="False" Background="{StaticResource BgPage}">
          <Border.OpacityMask>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#00000000" Offset="0" />
              <GradientStop Color="#00000000" Offset="0.1" />
              <GradientStop Color="#40000000" Offset="0.35" />
              <GradientStop Color="#99000000" Offset="0.6" />
              <GradientStop Color="#E6000000" Offset="0.82" />
              <GradientStop Color="#FF000000" Offset="1" />
            </LinearGradientBrush>
          </Border.OpacityMask>
        </Border>
        <Border x:Name="PagerCard" Style="{StaticResource Slab}" Padding="10,7"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,9,18" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Height="23">
            <Button x:Name="FirstBtn" Style="{StaticResource IcoBtn}" Height="23" Width="26"
                    Click="First_Click" ToolTip="第一页">
              <v:Ico Glyph="{StaticResource I.First}" Height="11" />
            </Button>
            <Button x:Name="PrevBtn" Style="{StaticResource IcoBtn}" Height="23" Width="26"
                    Click="Prev_Click" ToolTip="上一页">
              <v:Ico Glyph="{StaticResource I.Prev}" Height="11" />
            </Button>
            <TextBlock x:Name="PageText" FontSize="{StaticResource FsTitle}" Margin="12,0"
                       VerticalAlignment="Center" Foreground="{StaticResource TextBody}" />
            <Button x:Name="NextBtn" Style="{StaticResource IcoBtn}" Height="23" Width="26"
                    Click="Next_Click" ToolTip="下一页">
              <v:Ico Glyph="{StaticResource I.Next}" Height="11" />
            </Button>
          </StackPanel>
        </Border>
        </Grid>

        <Grid x:Name="PaneDetail" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" x:Name="DetailHead" Padding="16,10,25,10"
                  Background="{StaticResource BgCard}"
                  BorderBrush="{StaticResource LineDivider}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource IcoBtn}" Click="DetailBack_Click" ToolTip="返回">
                <v:Ico Glyph="{StaticResource I.Prev}" Height="13" />
              </Button>
              <TextBlock x:Name="DetailHeadTitle" Style="{StaticResource SectionTitle}"
                         VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Row="1" Padding="{StaticResource PadPage}" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Slab}">
                <StackPanel>
                  <Grid Margin="{StaticResource GapField}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="DetailMono" Style="{StaticResource MonogramLg}"
                                    VerticalAlignment="Top" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock x:Name="DetailTitle" FontSize="{StaticResource FsSection}"
                                 FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                 TextWrapping="Wrap" />
                      <TextBlock x:Name="DetailTags" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                      <TextBlock x:Name="DetailBundle" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="DetailBody" Style="{StaticResource Body}" Margin="{StaticResource GapField}" />
                  <TextBlock x:Name="DetailMeta" Style="{StaticResource Muted}" Margin="{StaticResource GapField}" />
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="DetailHomeBtn" Style="{StaticResource BtnWide}" Content="打开主页"
                            Margin="0,0,10,0" Click="DetailHome_Click"
                            v:Ico.Of="{StaticResource I.Globe}" />
                    <Button Style="{StaticResource BtnWide}" Content="打开 npm" Margin="0,0,10,0"
                            Click="DetailNpm_Click" v:Ico.Of="{StaticResource I.Globe}" />
                    <Button Style="{StaticResource BtnWide}" Content="复制名称"
                            Click="DetailCopy_Click" v:Ico.Of="{StaticResource I.Copy}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Slab}" Padding="14,10">
                <Grid x:Name="DetailChipHost" local:Fx.SlideSelect="pill"
                      HorizontalAlignment="Left" VerticalAlignment="Top">
                  <Border Style="{StaticResource SlideThumbPill}">
                    <Border.RenderTransform>
                      <TranslateTransform />
                    </Border.RenderTransform>
                  </Border>
                  <WrapPanel x:Name="DetailChips" />
                </Grid>
              </Border>
              <Border Style="{StaticResource Slab}">
                <StackPanel>
                  <TextBlock x:Name="DetailFileHead" Style="{StaticResource CardTitle}" Text="可下版本" />
                  <ItemsControl x:Name="DetailFileList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid local:Fx.Enter="row" Height="56">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <ContentControl Grid.Column="0" Style="{StaticResource MonogramSm}"
                                          Content="{Binding Channel}" VerticalAlignment="Center"
                                          Margin="4,0,0,0" />
                          <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"
                                      Cursor="Hand" MouseLeftButtonUp="File_InstallRow" Tag="{Binding}">
                            <TextBlock Text="{Binding Title}" FontSize="{StaticResource FsRow}"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Line}" Style="{StaticResource Muted}" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Button Grid.Column="2" Style="{StaticResource IcoBtn}" Margin="0,0,4,0"
                                  VerticalAlignment="Center" Click="File_Install" Tag="{Binding}"
                                  ToolTip="装到所选实例">
                            <v:Ico Glyph="{StaticResource I.Download}" Height="13" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <ScrollViewer x:Name="PaneDlTasks" Padding="{StaticResource PadPage}" VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
        <StackPanel>
          <Border Style="{StaticResource Slab}">
            <StackPanel>
              <ContentControl Style="{StaticResource SlabHead}" Content="正在下载的"
                              v:Ico.Of="{StaticResource I.Download}" />
              <ItemsControl x:Name="DlRunning" ItemTemplate="{StaticResource DlJobRow}" />
              <TextBlock x:Name="DlEmptyRun" Text="没有正在下载的" Style="{StaticResource Muted}"
                         Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Slab}">
            <StackPanel>
              <Grid Margin="{StaticResource GapTight}">
                <ContentControl Style="{StaticResource SlabHead}" Content="下载完成的" Margin="0"
                                v:Ico.Of="{StaticResource I.Tasks}" HorizontalAlignment="Left"
                                VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Style="{StaticResource BtnSm}" Content="全部清除" Margin="0,0,8,0"
                          Click="DlClear_Click" ToolTip="从列表中删除已完成的下载，不删已装的文件" />
                  <Button Style="{StaticResource IcoBtn}" Click="DlRefresh_Click" ToolTip="刷新">
                    <v:Ico Glyph="{StaticResource I.Refresh}" Height="12" />
                  </Button>
                </StackPanel>
              </Grid>
              <ItemsControl x:Name="DlDone" ItemTemplate="{StaticResource DlJobRow}" />
              <TextBlock x:Name="DlEmptyDone" Text="没有下载完成的" Style="{StaticResource Muted}"
                         Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Popup x:Name="StoreLayoutPop" Placement="Bottom"
           PlacementTarget="{Binding ElementName=StoreLayoutBtn}"
           StaysOpen="False" AllowsTransparency="True"
           Opened="StoreLayoutPop_Opened" Closed="StoreLayoutPop_Closed">
      <Border Background="{StaticResource BgPage}" CornerRadius="{StaticResource RadCard}"
              Padding="12,10" Margin="0,6,0,0" BorderBrush="{StaticResource LineBorder}"
              BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.12"
                            Color="#20303F" />
        </Border.Effect>
        <StackPanel>
          <TextBlock Text="每行" Style="{StaticResource Muted}" FontSize="{StaticResource FsSmall}"
                     Margin="2,0,0,8" />
          <Grid x:Name="ColHost">
            <Border x:Name="ColPill" Style="{StaticResource SlideThumbPill}" Opacity="0"
                    RenderTransformOrigin="0,0.5">
              <Border.RenderTransform>
                <TransformGroup>
                  <ScaleTransform x:Name="ColPillScale" />
                  <TranslateTransform x:Name="ColPillShift" />
                </TransformGroup>
              </Border.RenderTransform>
            </Border>
            <StackPanel x:Name="ColRow" Orientation="Horizontal">
              <RadioButton x:Name="Col2" Style="{StaticResource FilterTab}" Content="2" Tag="2"
                           MinWidth="36" Padding="10,0" Margin="0" Checked="StoreColumns_Changed" />
              <RadioButton x:Name="Col3" Style="{StaticResource FilterTab}" Content="3" Tag="3"
                           MinWidth="36" Padding="10,0" Margin="0" IsChecked="True"
                           Checked="StoreColumns_Changed" />
              <RadioButton x:Name="Col4" Style="{StaticResource FilterTab}" Content="4" Tag="4"
                           MinWidth="36" Padding="10,0" Margin="0" Checked="StoreColumns_Changed" />
              <RadioButton x:Name="Col5" Style="{StaticResource FilterTab}" Content="5" Tag="5"
                           MinWidth="36" Padding="10,0" Margin="0" Checked="StoreColumns_Changed" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
